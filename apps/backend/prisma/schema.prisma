generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  USER
  ADMIN
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PENDING
  ACTIVE
  CANCELLED
  ARCHIVED
  DELETED
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EventLocationType {
  VENUE
  ONLINE
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
  CHECKED_IN
}

enum BookingType {
  FREE
  PAID
  DONATION
  RSVP
}

// Models
model User {
  id                        String              @id @default(cuid())
  email                     String?             @unique @db.VarChar(255)
  phone                     String?             @unique @db.VarChar(20)
  password                  String?             @db.VarChar(255)
  name                      String?             @db.VarChar(255)
  displayName               String?             @map("display_name") @db.VarChar(255)
  avatar                    String?             @db.Text
  avatarUrl                 String?             @map("avatar_url") @db.Text
  bio                       String?             @db.Text
  role                      UserRole            @default(USER)
  emailVerified             Boolean             @default(false) @map("email_verified")
  phoneVerified             Boolean             @default(false) @map("phone_verified")
  isVerified                Boolean             @default(false) @map("is_verified")
  isOrganizer               Boolean             @default(false) @map("is_organizer")
  isAdmin                   Boolean             @default(false) @map("is_admin")
  
  // Preferences
  interests                 Json?               @db.Json
  preferences               Json?               @db.Json
  settings                  Json?               @db.Json
  
  // Stats
  eventCount                Int?                @default(0) @map("event_count")
  wishlistCount             Int?                @default(0) @map("wishlist_count")
  followerCount             Int?                @default(0) @map("follower_count")
  followingCount            Int?                @default(0) @map("following_count")
  
  
  // Phone verification
  phoneVerificationCode     String?             @map("phone_verification_code") @db.VarChar(10)
  phoneVerificationExpires  DateTime?           @map("phone_verification_expires")
  
  // Social auth
  firebaseUid               String?             @unique @map("firebase_uid") @db.VarChar(255)
  authMethod                String?             @map("auth_method") @db.VarChar(50)
  googleId                  String?             @unique @map("google_id") @db.VarChar(255)
  appleId                   String?             @unique @map("apple_id") @db.VarChar(255)
  facebookId                String?             @unique @map("facebook_id") @db.VarChar(255)
  
  // Social links
  website                   String?             @db.Text
  twitter                   String?             @db.VarChar(255)
  instagram                 String?             @db.VarChar(255)
  linkedin                  String?             @db.VarChar(255)
  
  // Relations
  passkeys                  Passkey[]
  passkeyChallenges         PasskeyChallenge[]
  refreshTokens             RefreshToken[]
  organizedEvents           Event[]             @relation("Organizer")
  bookings                  Booking[]
  reviews                   Review[]
  wishlists                 Wishlist[]
  eventViews                EventView[]
  searchLogs                SearchLog[]
  organizerProfile          OrganizerProfile?
  notifications             Notification[]
  deviceTokens              DeviceToken[]
  conversationLogs          ConversationLog[]
  chatSessions              ChatSession[]
  
  // Timestamps
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  lastLoginAt               DateTime?           @map("last_login_at")
  lastActiveAt              DateTime?           @map("last_active_at")

  @@map("users")
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([createdAt])
  @@index([isOrganizer])
  @@index([isVerified])
}

model Event {
  id                        String              @id @default(cuid())
  migoId                    String?             @unique @map("migo_id") @db.VarChar(255)
  slug                      String?             @unique @db.VarChar(255)
  title                     String              @db.VarChar(255)
  tagline                   String?             @db.VarChar(500)
  description               String              @db.Text
  shortDescription          String?             @map("short_description") @db.VarChar(500)
  category                  String              @db.VarChar(100)
  subcategory               String?             @db.VarChar(100)
  tags                      Json?               @db.Json // Changed from String[]
  
  // Dates
  startDate                 DateTime            @map("start_date")
  endDate                   DateTime?           @map("end_date")
  durationMinutes           Int?                @map("duration_minutes")
  timezone                  String              @default("UTC") @db.VarChar(50)
  isRecurring               Boolean             @default(false) @map("is_recurring")
  
  // Location
  venueName                 String?             @map("venue_name") @db.VarChar(255)
  address                   String?             @db.Text
  city                      String?             @db.VarChar(100)
  country                   String?             @db.VarChar(100)
  latitude                  Float?
  longitude                 Float?
  locationType              EventLocationType   @default(VENUE) @map("location_type")
  onlineUrl                 String?             @map("online_url") @db.Text
  
  // Pricing
  priceFrom                 Decimal?            @map("price_from") @db.Decimal(10, 2)
  priceTo                   Decimal?            @map("price_to") @db.Decimal(10, 2)
  currency                  String              @default("USD") @db.VarChar(3)
  isFree                    Boolean             @default(false) @map("is_free")
  ticketUrl                 String?             @map("ticket_url") @db.Text
  bookingType               BookingType         @default(PAID) @map("booking_type")
  capacity                  Int?                @default(0)
  ticketsSold               Int?                @default(0) @map("tickets_sold")
  ticketsAvailable          Int?                @default(0) @map("tickets_available")
  
  // Media
  images                    Json?               @db.Json // Changed from String[]
  coverImage                String?             @map("cover_image") @db.Text
  thumbnailImage            String?             @map("thumbnail_image") @db.Text
  videoUrl                  String?             @map("video_url") @db.Text
  gallery                   Json?               @db.Json
  
  // Features
  isPetFriendly             Boolean             @default(false) @map("is_pet_friendly")
  isWheelchairAccessible    Boolean             @default(false) @map("is_wheelchair_accessible")
  hasParking                Boolean             @default(false) @map("has_parking")
  hasFood                   Boolean             @default(false) @map("has_food")
  hasDrinks                 Boolean             @default(false) @map("has_drinks")
  hasWiFi                   Boolean             @default(false) @map("has_wifi")
  facilities                Json?               @db.Json // Changed from String[]
  dressCode                 String?             @map("dress_code") @db.VarChar(100)
  ageRestriction            Int?                @map("age_restriction")
  ageGroup                  String?             @map("age_group") @db.VarChar(50)
  
  // Status
  status                    EventStatus         @default(PENDING)
  visibility                EventVisibility     @default(PUBLIC)
  isFeatured                Boolean             @default(false) @map("is_featured")
  isSponsored               Boolean             @default(false) @map("is_sponsored")
  isVerified                Boolean             @default(false) @map("is_verified")
  featuredOrder             Int?                @map("featured_order")
  featuredUntil             DateTime?           @map("featured_until")
  
  // External
  externalId                String?             @unique @map("external_id") @db.VarChar(255)
  externalSource            String?             @map("external_source") @db.VarChar(50)
  externalUrl               String?             @map("external_url") @db.Text
  source                    String?             @db.VarChar(50)
  
  // Contact
  organizerEmail            String?             @map("organizer_email") @db.VarChar(255)
  organizerPhone            String?             @map("organizer_phone") @db.VarChar(20)
  supportEmail              String?             @map("support_email") @db.VarChar(255)
  supportPhone              String?             @map("support_phone") @db.VarChar(20)
  website                   String?             @db.Text
  socialLinks               Json?               @map("social_links") @db.Json
  
  // Stats
  views                     Int?                @default(0)
  uniqueViews               Int?                @default(0) @map("unique_views")
  wishlistCount             Int?                @default(0) @map("wishlist_count")
  shareCount                Int?                @default(0) @map("share_count")
  clickCount                Int?                @default(0) @map("click_count")
  ratingAverage             Float?              @default(0) @map("rating_average")
  ratingCount               Int?                @default(0) @map("rating_count")
  
  // Relations
  organizerId               String              @map("organizer_id")
  organizer                 User                @relation("Organizer", fields: [organizerId], references: [id])
  bookings                  Booking[]
  reviews                   Review[]
  wishlists                 Wishlist[]
  eventViews                EventView[]
  searchLogs                SearchLog[]
  categoryRelation          Category?           @relation(fields: [categoryId], references: [id])
  categoryId                String?             @map("category_id")
  
  // Timestamps
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  publishedAt               DateTime?           @map("published_at")
  approvedAt                DateTime?           @map("approved_at")

  @@map("events")
  @@index([organizerId])
  @@index([category])
  @@index([subcategory])
  @@index([city])
  @@index([country])
  @@index([startDate])
  @@index([status])
  @@index([visibility])
  @@index([isFeatured])
  @@index([isFree])
  @@index([isPetFriendly])
  @@index([ratingAverage])
  @@index([wishlistCount])
  @@index([createdAt])
  @@index([slug])
  @@index([categoryId])
}

model Booking {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  eventId         String        @map("event_id")
  ticketCount     Int           @default(1) @map("ticket_count")
  totalAmount     Decimal?      @map("total_amount") @db.Decimal(10, 2)
  currency        String        @default("USD") @db.VarChar(3)
  status          BookingStatus @default(PENDING)
  bookingDate     DateTime      @default(now()) @map("booking_date")
  ticketUrl       String?       @map("ticket_url") @db.Text
  qrCode          String?       @map("qr_code") @db.Text
  transactionId   String?       @map("transaction_id") @db.VarChar(255)
  paymentMethod   String?       @map("payment_method") @db.VarChar(50)
  notes           String?       @db.Text
  
  // Contact info for ticket
  attendeeName    String?       @map("attendee_name") @db.VarChar(255)
  attendeeEmail   String?       @map("attendee_email") @db.VarChar(255)
  attendeePhone   String?       @map("attendee_phone") @db.VarChar(20)
  
  // Check-in
  checkedInAt     DateTime?     @map("checked_in_at")
  checkedInBy     String?       @map("checked_in_by") @db.VarChar(255)
  
  // Relations
  user            User          @relation(fields: [userId], references: [id])
  event           Event         @relation(fields: [eventId], references: [id])

  @@map("bookings")
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([bookingDate])
  @@unique([userId, eventId])
}

model Review {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  eventId         String    @map("event_id")
  overallRating   Int       @default(5) @map("overall_rating") @db.TinyInt
  title           String?   @db.VarChar(200)
  comment         String?   @db.Text
  isRecommended   Boolean   @default(true) @map("is_recommended")
  isFeatured      Boolean   @default(false) @map("is_featured")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  event           Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("reviews")
  @@index([userId])
  @@index([eventId])
  @@index([overallRating])
  @@index([isFeatured])
  @@index([createdAt])
}

model Wishlist {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  eventId         String    @map("event_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  event           Event     @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@map("wishlists")
  @@index([userId])
  @@index([eventId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Passkey {
  id            String   @id @default(cuid())
  userId        String
  credentialID  String   @unique
  publicKey     Bytes
  counter       BigInt
  deviceType    String?   @db.VarChar(50)
  backedUp      Boolean  @default(false)
  transports    Json?     @db.Json
  
  // Relations
  user          User     @relation(fields: [userId], references: [id])
  
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  type      String   @db.VarChar(20)
  expiresAt DateTime
  
  // Relations
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
  @@map("passkey_challenges")
}

// New models needed for the events service

model EventView {
  id              String   @id @default(cuid())
  eventId         String   @map("event_id")
  userId          String?  @map("user_id")
  sessionId       String?  @map("session_id") @db.VarChar(255)
  source          String   @db.VarChar(50)
  deviceType      String?  @map("device_type") @db.VarChar(50)
  userAgent       String?  @map("user_agent") @db.Text
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  viewedAt        DateTime @default(now()) @map("viewed_at")
  
  // Relations
  event           Event    @relation(fields: [eventId], references: [id])
  user            User?    @relation(fields: [userId], references: [id])

  @@map("event_views")
  @@index([eventId])
  @@index([userId])
  @@index([viewedAt])
  @@index([source])
}

model SearchLog {
  id              String   @id @default(cuid())
  userId          String?  @map("user_id")
  eventId         String?  @map("event_id")
  query           String   @db.VarChar(255)
  filters         Json?    @db.Json
  resultsCount    Int      @map("results_count")
  deviceType      String?  @map("device_type") @db.VarChar(50)
  userAgent       String?  @map("user_agent") @db.Text
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relations
  user            User?    @relation(fields: [userId], references: [id])
  event           Event?   @relation(fields: [eventId], references: [id])

  @@map("search_logs")
  @@index([userId])
  @@index([query])
  @@index([createdAt])
  @@index([eventId])
}

model OrganizerProfile {
  id              String    @id @default(cuid())
  userId          String    @unique @map("user_id")
  businessName    String    @map("business_name") @db.VarChar(255)
  businessEmail   String?   @map("business_email") @db.VarChar(255)
  businessPhone   String?   @map("business_phone") @db.VarChar(20)
  businessWebsite String?   @map("business_website") @db.Text
  description     String?   @db.Text
  logo            String?   @db.Text
  banner          String?   @db.Text
  taxId           String?   @map("tax_id") @db.VarChar(50)
  vatNumber       String?   @map("vat_number") @db.VarChar(50)
  
  // Social
  socialLinks     Json?     @map("social_links") @db.Json
  
  // Stats
  totalEvents     Int       @default(0) @map("total_events")
  totalSales      Decimal?  @default(0) @map("total_sales") @db.Decimal(12, 2)
  averageRating   Float?    @default(0) @map("average_rating")
  reviewCount     Int       @default(0) @map("review_count")
  
  // Verification
  isVerified      Boolean   @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  
  // Bank/Stripe info
  stripeAccountId String?   @map("stripe_account_id") @db.VarChar(255)
  bankAccount     Json?     @map("bank_account") @db.Json
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])

  @@map("organizer_profiles")
  @@index([userId])
  @@index([businessName])
  @@index([isVerified])
}

model Category {
  id              String    @id @default(cuid())
  name            String    @unique @db.VarChar(100)
  slug            String    @unique @db.VarChar(100)
  description     String?   @db.Text
  icon            String?   @db.VarChar(50)
  color           String?   @db.VarChar(7)
  parentId        String?   @map("parent_id")
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  parent          Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  subcategories   Category[] @relation("CategoryHierarchy")
  events          Event[]
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("categories")
  @@index([slug])
  @@index([parentId])
  @@index([sortOrder])
  @@index([isActive])
}

model Tag {
  id              String    @id @default(cuid())
  name            String    @unique @db.VarChar(100)
  slug            String    @unique @db.VarChar(100)
  description     String?   @db.Text
  usageCount      Int       @default(0) @map("usage_count")
  isActive        Boolean   @default(true) @map("is_active")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("tags")
  @@index([slug])
  @@index([usageCount])
  @@index([isActive])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  type            String    @db.VarChar(50)
  title           String    @db.VarChar(255)
  message         String    @db.Text
  data            Json?     @db.Json
  isRead          Boolean   @default(false) @map("is_read")
  isSent          Boolean   @default(false) @map("is_sent")
  sendAt          DateTime? @map("send_at")
  sentAt          DateTime? @map("sent_at")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("notifications")
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([isSent])
  @@index([sendAt])
}

model DeviceToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  token           String    @unique @db.VarChar(500) // Changed from @db.Text
  platform        String    @db.VarChar(20)
  isActive        Boolean   @default(true) @map("is_active")
  
  // Relations
  user            User      @relation(fields: [userId], references: [id])
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("device_tokens")
  @@index([userId])
  @@index([platform])
  @@index([isActive])
}

model ConversationLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  userMessage  String   @map("user_message")
  aiResponse   String   @map("ai_response")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([createdAt])
  @@map("conversation_logs")
}

model ChatSession {
  id              String        @id @default(cuid())
  sessionId       String        @unique @map("session_id") @db.VarChar(255)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id])
  title           String?       @db.VarChar(255)
  context         Json?         @db.Json
  messageCount    Int           @default(0) @map("message_count")
  tokenCount      Int           @default(0) @map("token_count")
  durationMinutes Int           @default(0) @map("duration_minutes")
  isActive        Boolean       @default(true) @map("is_active")
  isArchived      Boolean       @default(false) @map("is_archived")
  archivedAt      DateTime?     @map("archived_at")
  lastMessageAt   DateTime?     @map("last_message_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  
  messages        ChatMessage[]
  
  @@map("chat_sessions")
  @@index([userId])
  @@index([sessionId])
  @@index([isActive])
  @@index([isArchived])
  @@index([lastMessageAt])
}

model ChatMessage {
  id              String        @id @default(cuid())
  sessionId       String        @map("session_id")
  session         ChatSession   @relation(fields: [sessionId], references: [id])
  role            String        @db.VarChar(20)
  content         String        @db.Text
  tokens          Int?          @default(0)
  aiModel         String?       @map("ai_model") @db.VarChar(100)
  aiResponseTime  Int?          @map("ai_response_time")
  aiUsage         Json?         @map("ai_usage") @db.Json
  context         Json?         @db.Json
  createdAt       DateTime      @default(now()) @map("created_at")
  
  @@map("chat_messages")
  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}